{
  "name": "filestr-grayjay-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Grayjay source plugin for filestr (authored in TypeScript, compiled to FilestrScript.js).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check-sync": "tsc -p tsconfig.json && git diff --exit-code -- FilestrScript.js",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "pretest": "cd .. && cargo build -q -p filestrd --features grayjay && cargo build -q -p filestrctl",
    "test": "tsc -p tsconfig.test.json && node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/grayjay-source": "gitlab:kaidelorenzo/grayjay-plugin-types#6743b69e9b2a3afffa54cf2a9d3c46033e76021c",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
