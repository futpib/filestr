{
  // Type-checks the node:test e2e suite (test/**/*.ts). Separate from the plugin
  // tsconfig (which emits a single classic script): these are real ESM Node
  // modules, run directly by `node --test` (type-stripping) and checked here.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["test/**/*.ts"]
}
